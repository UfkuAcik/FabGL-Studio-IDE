{
  "kind": "FabGLStudioProject",
  "formatVersion": 2,
  "projectGuid": "10000000-0000-4000-8000-000000000008",
  "name": "Audio Showcase",
  "projectRoot": ".",
  "startupScene": "Scenes/Main.fglscene",
  "build": {
    "program": "cmake",
    "arguments": ["--build", "out/build/dev"]
  },
  "assets": [
    {"guid": "50000000-0000-4000-8000-000000000008", "path": "Assets/Tone.fgla", "type": "audio"}
  ],
  "input": {
    "contexts": [
      {
        "name": "audio-demo",
        "priority": 0,
        "enabled": true,
        "actions": [
          {
            "name": "NextTrack",
            "bindings": [
              {"control": "Key.N", "scale": 1, "threshold": 0.5}
            ]
          },
          {
            "name": "PlayPause",
            "bindings": [
              {"control": "Key.Space", "scale": 1, "threshold": 0.5}
            ]
          }
        ],
        "axes": [
          {
            "name": "Volume",
            "bindings": [
              {"control": "Key.Down", "scale": -1, "threshold": 0.5},
              {"control": "Key.Up", "scale": 1, "threshold": 0.5}
            ]
          }
        ]
      }
    ]
  },
  "packages": [],
  "targetProfiles": {
    "pc": "pc.default",
    "esp32": "olimex-esp32-sbc-fabgl-revb"
  }
}
