{
  "kind": "FabGLStudioProject",
  "formatVersion": 2,
  "projectGuid": "10000000-0000-4000-8000-000000000009",
  "name": "Animation Showcase",
  "projectRoot": ".",
  "startupScene": "Scenes/Main.fglscene",
  "build": {
    "program": "cmake",
    "arguments": ["--build", "out/build/dev"]
  },
  "assets": [
    {"guid": "50000000-0000-4000-8000-000000000009", "path": "Assets/Animated.fgli", "type": "image"},
    {"guid": "52000000-0000-4000-8000-000000000009", "path": "Assets/Showcase.fglcontroller", "type": "animation.controller"},
    {"guid": "53000000-0000-4000-8000-000000000009", "path": "Assets/Idle.fglanim", "type": "animation.clip"},
    {"guid": "54000000-0000-4000-8000-000000000009", "path": "Assets/AnimatedCharacter.fglprefab", "type": "prefab"}
  ],
  "input": {
    "contexts": [
      {
        "name": "animation-demo",
        "priority": 0,
        "enabled": true,
        "actions": [
          {
            "name": "NextClip",
            "bindings": [
              {"control": "Key.N", "scale": 1, "threshold": 0.5}
            ]
          },
          {
            "name": "TogglePlayback",
            "bindings": [
              {"control": "Key.Space", "scale": 1, "threshold": 0.5}
            ]
          }
        ],
        "axes": [
          {
            "name": "PlaybackSpeed",
            "bindings": [
              {"control": "Key.Down", "scale": -0.25, "threshold": 0.5},
              {"control": "Key.Up", "scale": 0.25, "threshold": 0.5}
            ]
          }
        ]
      }
    ]
  },
  "packages": [],
  "targetProfiles": {
    "pc": "pc.default",
    "esp32": "olimex-esp32-sbc-fabgl-revb"
  }
}
