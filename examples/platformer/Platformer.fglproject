  "input": {
    "contexts": [
      {
        "name": "gameplay",
        "priority": 0,
        "enabled": true,
        "actions": [
          {
            "name": "Jump",
            "bindings": [
              {"control": "Key.Space", "scale": 1, "threshold": 0.5}
            ]
          },
          {
